<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower read this when a backup runs. Detent keeps its setup, the usage record, and the
     user's own wallpapers out of the backup. Android 12 and higher read data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
